{
  "name": "@ssegning/tiptap-schema",
  "version": "0.1.0",
  "private": true,
  "description": "The single Tiptap document schema shared by the CMS (Markdown -> JSON) and the website (JSON -> HTML).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/html": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
