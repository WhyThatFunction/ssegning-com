# Server-side base URL of the Strapi CMS. In-cluster this points at the
# Strapi service DNS name; locally point it at your dev Strapi instance.
# Every fetch in src/lib/strapi.ts fails soft (returns null/[]) if this is
# unreachable, so the site still renders with apps/web/src/content/fallback.ts
# copy when Strapi is down or this is misconfigured.
STRAPI_URL=http://localhost:1337

# Canonical public origin of this site, used for metadata, sitemap.xml,
# robots.txt, and Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=https://ssegning.com

# Shared secret for POST /api/revalidate. Must equal the CMS's
# WEB_REVALIDATE_SECRET so the CMS can trigger on-demand ISR revalidation
# after content changes. Sent by the caller as the `x-revalidate-secret`
# header.
REVALIDATE_SECRET=change-me

# giscus (GitHub Discussions comments on journal articles). Read server-side
# by app/journal/[slug]/page.tsx (a Server Component) and passed down to
# src/components/comments.tsx as props — see "Comments" in README.md for the
# exact setup steps and why these are deliberately NOT NEXT_PUBLIC_*.
#
# apps/web's image is built in CI, which has no giscus config, and the real
# values are only supplied later as plain env vars on the Kubernetes
# Deployment. NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD
# time, so if these were NEXT_PUBLIC_* they would be frozen as `undefined`
# forever regardless of what the Deployment sets — comments would silently
# never render in production. Plain (non-NEXT_PUBLIC_) vars are instead read
# via process.env at request time in the Server Component, so a Deployment
# env change takes effect on the next pod restart, no rebuild required.
# Do not rename these to NEXT_PUBLIC_GISCUS_* — that reintroduces the bug.
#
# Leave all four unset to build/run with comments disabled — comments.tsx
# renders nothing (no error, no layout gap) in that case.
GISCUS_REPO=WhyThatFunction/ssegning-com
GISCUS_REPO_ID=R_kgDOUKZKdQ
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=DIC_kwDOUKZKdc4DEoBK
