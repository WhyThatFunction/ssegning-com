{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Landing page hero, metrics and intro content."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroEyebrow": {
      "type": "string"
    },
    "heroHeadline": {
      "type": "string",
      "required": true
    },
    "heroSubline": {
      "type": "text"
    },
    "primaryCta": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "secondaryCta": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "metrics": {
      "type": "component",
      "component": "shared.metric",
      "repeatable": true
    },
    "introTitle": {
      "type": "string"
    },
    "introBody": {
      "type": "richtext"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
