# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate real random values for every deployment, never reuse
# these across environments. APP_KEYS is a comma-separated list of 4 keys.
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (Postgres)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Public URLs
PUBLIC_URL=https://cms.ssegning.com
STRAPI_ADMIN_BACKEND_URL=https://cms.ssegning.com

# S3 uploads (MinIO, path-style)
S3_ENDPOINT=https://s3.ssegning.me
S3_REGION=us-east-1
S3_BUCKET=ssegning-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE=https://s3.ssegning.me/ssegning-uploads

# apps/web on-demand revalidation
WEB_REVALIDATE_URL=http://ssegning-web:3000/api/revalidate
WEB_REVALIDATE_SECRET=

# Outbound email (in-cluster postfix relay, mail-system namespace) — see
# config/plugins.ts. Port 587 is STARTTLS submission, authenticated with
# SASL. SMTP_SASL_USERS is the raw `user:password` value of the relay's
# own smtpd_sasl_users property (fetched from AWS Secrets Manager in
# deploy, not committed here); leaving these unset in local dev just
# disables outbound mail and Apprise alerting below — nothing else breaks.
SMTP_HOST=mail.mail-system.svc.cluster.local
SMTP_PORT=587
SMTP_SASL_USERS=
# The relay enforces ALLOWED_SENDER_DOMAINS — keep this on a domain it
# permits, or postfix rejects the message.
EMAIL_DEFAULT_FROM=no-reply@ssegning.com
EMAIL_DEFAULT_REPLY_TO=hello@ssegning.com
# The in-cluster relay presents a self-signed cert; leave this false
# (the default) unless it's been given a trusted one.
SMTP_TLS_REJECT_UNAUTHORIZED=false

# Deploy/bootstrap alerting via the in-cluster Apprise instance
# (notification-system namespace) — see src/lib/apprise.ts. Leaving
# APPRISE_URL unset in local dev disables alerting entirely (no-op, not
# an error). By default an alert `mailto://` URL is derived from the
# SMTP_* settings above plus APPRISE_ALERT_TO; set APPRISE_ALERT_URLS to
# override with arbitrary Apprise URLs (Slack, Telegram, etc.) instead.
APPRISE_URL=http://apprise.notification-system.svc.cluster.local:8000
APPRISE_ALERT_TO=
APPRISE_ALERT_URLS=

# Super admin bootstrap — creates the one Strapi super admin on first boot
# (only when zero admin users exist yet) so the /admin registration screen
# is never left open to the first visitor. Leave all four unset for local
# dev to use the normal /admin registration flow instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
